## ql repo命令拉取脚本时需要拉取的文件后缀，直接写文件后缀名即可
RepoFileExtensions="js py txt"

# server酱的 PUSH_KEY
export PUSH_KEY_MY=
export PUSH_KEY_SECOND=

## PushMe key
export PUSH_ME_KEY=
## 邮箱地址和smtp密钥
export EMAIL_ADDRESS=
export EMAIL_PWD=

## 钉钉机器人key
export XB_BOT_TOKEN=
export JOB_BOT_TOKEN=

## Gemini API密钥和API域名
export API_KEY=
export API_URL=

## WorkBuddy 每日签到（workbuddy_checkin.py）
# 脚本【默认只读取以下环境变量】，不再自动读取本机登录态
# token 过期时，在本机（已登录 WorkBuddy 桌面端 v5.3.8+）执行：python workbuddy_checkin.py --export-env --save 即可刷新
export WB_ACCESS_TOKEN=
export WB_USER_ID=

## Trae Work 每日签到（trae_checkin.py）
# 脚本【默认只读取以下环境变量】，不再自动解密本机登录态
# 【自动续期/自愈】access token 仅约 14 天有效；脚本内置 ExchangeToken 续期（用 refreshToken + 设备 ECDSA
#   私钥换发新 token），在「无 token / 即将过期 / 鉴权失败」时自动续期并重试，无需每天手动刷新。
# 引导一次性材料（本机已登录 Trae 桌面端执行：python trae_checkin.py --export-keys --save）：
export TRAE_TOKEN=
export TRAE_DEVICE_ID=
export TRAE_USER_ID=
# —— 以下为自动续期所需材料（重要！缺了就只能退化成“请重新登录”提示）——
export TRAE_REFRESH_TOKEN=
export TRAE_DEVICE_KEY_PEM=
export TRAE_DEVICE_PUB_PEM=
export TRAE_MACHINE_ID=
# 说明：TRAE_DEVICE_KEY_PEM 是设备 ECDSA 私钥（用于签名设备证明），属敏感凭据，请勿外泄；
#   它使脚本可在无 Trae 桌面端的服务器上自动续期。续期后最新凭据也会写入 .trae_token.json（已 gitignore）。
#   - 设备 id 取 storage.json 中 iCubeAuthInfo://icube-dc:<numeric> 键的数字部分；服务端按注册指纹校验 device id，
#     UUID 格式的 telemetry.devDeviceId 不被识别为注册设备，会触发更严格限流（sign 接口 code 9074）
#   - 切勿把设备 id 填成 UUID；--export-keys 导出的已是正确数字值

## MiniMax Code 每日签到（minimax_checkin.py）
# 脚本【默认只读取以下环境变量】，不再自动读取本机登录态
# 【先续期再签到】每次运行都会先调 /v1/api/user/renewal 用旧 token 换新 token（有效期顺延 ~40 天），
#   新 token 自动写回脚本同目录缓存 .minimax_token.json（青龙改不动环境变量，靠缓存自愈，永不续期失败）
# 注意：填 token 时千万别带引号（青龙面板最常见坑，会直接 401）；脚本会自动去除首尾空白与配对引号
# token 失效/过期时：先去 MiniMax Agent 客户端重新登录（让其写回新 token），再在本机执行：
#   python minimax_checkin.py --export-env --save  即可把最新 token/设备参数写回 .env
# 只想把现有 token 续期（任意机器、token 尚有效即可）：
#   python minimax_checkin.py --renew --save
export MINIMAX_TOKEN=
export MINIMAX_USER_ID=
# 可选：设备身份参数，留空时回落到脚本内写死的稳定默认值
export MINIMAX_UUID=
export MINIMAX_DEVICE_ID=
# 可选：DNS 污染兜底。若所在网络把 agent.minimax.io 解析到假 IP（如 198.20.0.x 拦截网关），
#   脚本会先用 DoH 自动解析真实 IP 绕过；若连 DoH 都不可达，可在此手动指定真实 IPv4。
#   取得方式（本机，不受污染 DNS 影响）：nslookup agent.minimax.io 8.8.8.8  或 访问 https://dns.google/resolve?name=agent.minimax.io&type=A
export MINIMAX_REAL_IP=
# 可选：覆盖本机登录态配置文件路径（仅 --export-env 读取时使用，默认 %APPDATA%\MiniMax Agent\minimax-agent-config.json）
export MINIMAX_CONFIG_PATH=
# 可选：设 1 关闭 token 缓存文件；设 MINIMAX_SAVE_ENV=0 则只写缓存不改写 .env
export MINIMAX_NO_CACHE=
