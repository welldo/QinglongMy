# server酱的 PUSH_KEY
PUSH_KEY_MY=
PUSH_KEY_SECOND=

## PushMe key
PUSH_ME_KEY=
## 邮箱地址和smtp密钥
EMAIL_ADDRESS=
EMAIL_PWD=

## 钉钉机器人key
XB_BOT_TOKEN=
JOB_BOT_TOKEN=

## Gemini API密钥和API域名
API_KEY=
API_URL=

## WorkBuddy 每日签到（workbuddy_checkin.py）
## 留空则自动读取本机 WorkBuddy 桌面端(v5.3.8+)明文登录态；跨机/容器部署时手动填写
WB_ACCESS_TOKEN=
WB_USER_ID=
## 可选：domain 一般留空自动读取
WB_DOMAIN=

## Trae Work 每日签到（trae_checkin.py）
## 留空则自动解密本机 Trae 桌面端登录态(%APPDATA%\TRAE SOLO CN\User\globalStorage\storage.json)
## 跨机/容器部署时，在本机执行 `python trae_checkin.py --export-env` 导出后填入
TRAE_TOKEN=
TRAE_DEVICE_ID=
TRAE_HOST=

## 微博热搜 Cookie（weibo_summary.py 用，带 SUB= 的登录态）
## 从浏览器登录 weibo.com 后 F12 复制 Cookie 头；留空则回退 newsnow 公开 Cookie（易失效）
WEIBO_COOKIE=


# 本地开发调试专用，无需配置到生产环境
IS_LOCAL_DEV=true